# Package-local recipe. Stage checksummed sources with packaging/arch/build.sh.
pkgname=arch-dotfiles-waybar
pkgver=0.3.0
pkgrel=1
pkgdesc='Waybar panel configuration'
arch=('any')
url='https://github.com/MichaelWeissDEV/dotfiles'
license=('LicenseRef-arch-dotfiles-bundle')
depends=('arch-dotfiles-core>=0.3.0' 'waybar' 'ttf-jetbrains-mono-nerd' 'libpulse' 'networkmanager' 'bluez-utils' 'power-profiles-daemon')
optdepends=()
options=('!strip')
source=('payload.tar.gz')
sha256sums=('__SOURCE_SHA256__')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
}
